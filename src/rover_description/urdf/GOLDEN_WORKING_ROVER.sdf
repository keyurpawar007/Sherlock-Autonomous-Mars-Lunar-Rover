              <mu2>0.2</mu2>
            </ode>
             <bullet>
    <friction>1.5</friction>
    <friction2>0.2</friction2>
    <fdir1>1 0 0</fdir1>
    <rolling_friction>0.1</rolling_friction>
  </bullet>
          </friction>
        </surface>
      </collision>
      <visual name='sheet_metal_motor_tyre_fr_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.09</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name='MR_wheel' type='revolute'>
      <pose relative_to='trapezoid_default_as_machined'>-0.268802 0.167162 -0.160513 0 -0 0.988601</pose>
      <parent>trapezoid_default_as_machined</parent>
      <child>sheet_metal_motor_tyre_fr_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>10</effort>
          <velocity>10</velocity>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='sheet_metal_motor_tyre_fr_2'>
      <pose relative_to='MR_wheel'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0.000463 5e-06 0.026652 0 -0 0</pose>
        <mass>5.26097</mass>
        <inertia>
          <ixx>0.0324874</ixx>
          <ixy>1.7127e-08</ixy>
          <ixz>-2.79212e-06</ixz>
          <iyy>0.0326651</iyy>
          <iyz>-2.11648e-06</iyz>
          <izz>0.0517133</izz>
        </inertia>
      </inertial>
      <collision name='sheet_metal_motor_tyre_fr_2_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.09</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+07</kp>
              <kd>1</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <fdir1>1 0 0</fdir1>
              <mu>1.5</mu>
              <mu2>0.2</mu2>
            </ode>
             <bullet>
    <friction>1.5</friction>
    <friction2>0.2</friction2>
    <fdir1>1 0 0</fdir1>
    <rolling_friction>0.1</rolling_friction>
  </bullet>
          </friction>
        </surface>
      </collision>
      <visual name='sheet_metal_motor_tyre_fr_2_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.09</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    
	 <joint name='right_trapezoid_loop_joint' type='revolute'>
  <pose relative_to='trapezoid_single_eye_default_as_machined'>-0.44131 0.00748 0.09730 0 0 0</pose>
  <parent>trapezoid_default_as_machined</parent>
  <child>trapezoid_single_eye_default_as_machined</child>
  <axis>
    <xyz expressed_in='base_footprint'>0 1 0</xyz>
    <limit>
      <lower>-1e16</lower>
      <upper>1e16</upper>
    </limit>
  </axis>
</joint>

<joint name='left_trapezoid_loop_joint' type='revolute'>
  <pose relative_to='trapezoid_single_eye_default_as_machined_2'>-0.42700 -0.00160 0.09610 0 0 0</pose>
  <parent>trapezoid_default_as_machined_2</parent>
  <child>trapezoid_single_eye_default_as_machined_2</child>
  <axis>
    <xyz expressed_in='base_footprint'>0 1 0</xyz>
    <limit>
      <lower>-1e16</lower>
      <upper>1e16</upper>
    </limit>
  </axis>
</joint> 

<!-- LiDAR -->
<link name='lidar_link'>
  <pose relative_to='base_footprint'>0 0 0.25 0 0 0</pose>

  <inertial>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.0001</ixx>
      <iyy>0.0001</iyy>
      <izz>0.0001</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name='lidar_collision'>
    <geometry>
      <cylinder>
        <radius>0.05</radius>
        <length>0.05</length>
      </cylinder>
    </geometry>
  </collision>

  <visual name='lidar_visual'>
    <geometry>
      <cylinder>
        <radius>0.05</radius>
        <length>0.05</length>
      </cylinder>
    </geometry>
  </visual>

  <sensor name='lidar_sensor' type='ray'>
    <pose>0 0 0 0 0 0</pose>

    <visualize>true</visualize>

    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <plugin name='lidar_plugin'
            filename='libgazebo_ros_ray_sensor.so'>
      <ros>
        <remapping>~/out:=/scan_raw</remapping>
      </ros>

      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_link</frame_name>
    </plugin>
  </sensor>
</link>

<joint name='lidar_joint' type='fixed'>
  <parent>base_footprint</parent>
  <child>lidar_link</child>
</joint>

<plugin name='gazebo_ros2_control' filename='libgazebo_ros2_control.so'>
      <parameters>__CONTROLLERS_YAML_PATH__</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
    
    
<!--<joint name='right_trapezoid_loop_joint' type='ball'>
  <pose relative_to='trapezoid_single_eye_default_as_machined'>-0.44131 0.00748 0.09730 0 0 0</pose>
  <parent>trapezoid_default_as_machined</parent>
  <child>trapezoid_single_eye_default_as_machined</child>
</joint>

<joint name='left_trapezoid_loop_joint' type='ball'>
  <pose relative_to='trapezoid_single_eye_default_as_machined_2'>-0.42700 -0.00160 0.09610 0 0 0</pose>
  <parent>trapezoid_default_as_machined_2</parent>
  <child>trapezoid_single_eye_default_as_machined_2</child>
</joint>-->


  
    <!-- SIMULATION-ONLY planar drive.
         Used because the detailed 6-wheel contact model resists skid yaw.
         Existing wheel odometry remains the odometry source. -->
    <plugin name='rover_planar_move'
            filename='libgazebo_ros_planar_move.so'>

      <ros>
        <remapping>cmd_vel:=/sim_cmd_vel</remapping>
      </ros>

      <update_rate>100</update_rate>

      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

    </plugin>

</model>
</sdf>
